{
  "name": "mui-pet-store-2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:proving": "playwright test --config playwright.proving.config.ts",
    "test:acceptance": "jest --config jest.acceptance.config.mjs",
    "test:acceptance:e2e": "playwright test --config playwright.acceptance.config.ts",
    "test:mutation": "stryker run",
    "check-versions": "node .vortex/check-versions.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "verify:full": "npm run verify && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "jest-junit": {
    "addFileAttribute": "true"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@libsql/client": "0.17.4",
    "@mui/material": "7.3.11",
    "@mui/material-nextjs": "7.3.10",
    "@tabler/icons-react": "3.50.0",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
