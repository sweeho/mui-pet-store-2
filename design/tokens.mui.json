{
  "$description": "The design tokens the MUI theme is built from (src/theme/theme.ts): the Design Reference (indigo, Inter, radius 4). Change the look here.",
  "palette": {
    "primary": {
      "main": "#4f46e5",
      "light": "#eef2ff",
      "dark": "#4338ca",
      "contrastText": "#ffffff"
    },
    "secondary": {
      "main": "#64748b",
      "light": "#f8fafc",
      "dark": "#475569",
      "contrastText": "#ffffff"
    },
    "success": {
      "main": "#16a34a",
      "contrastText": "#ffffff"
    },
    "info": {
      "main": "#0284c7",
      "contrastText": "#ffffff"
    },
    "error": {
      "main": "#dc2626",
      "contrastText": "#ffffff"
    },
    "warning": {
      "main": "#d97706",
      "contrastText": "#ffffff"
    },
    "grey": {
      "100": "#f8fafc",
      "200": "#f1f5f9",
      "300": "#e2e8f0",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#0f172a"
    },
    "text": {
      "primary": "#0f172a",
      "secondary": "#64748b"
    },
    "divider": "#e2e8f0",
    "background": {
      "default": "#f8fafc",
      "paper": "#ffffff"
    }
  },
  "typography": {
    "fontFamily": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Arial, sans-serif",
    "h1": {
      "fontWeight": 700,
      "fontSize": "2rem",
      "lineHeight": 1.2,
      "letterSpacing": "-0.01em"
    },
    "h2": {
      "fontWeight": 600,
      "fontSize": "1rem",
      "lineHeight": 1.45
    },
    "h3": {
      "fontWeight": 600,
      "fontSize": "1.25rem",
      "lineHeight": 1.3
    },
    "h4": {
      "fontWeight": 700,
      "fontSize": "1rem",
      "lineHeight": 1.45
    },
    "h5": {
      "fontWeight": 600,
      "fontSize": "1rem",
      "lineHeight": 1.45
    },
    "h6": {
      "fontWeight": 600,
      "fontSize": "0.875rem",
      "lineHeight": 1.45
    },
    "button": {
      "textTransform": "none",
      "fontWeight": 500
    },
    "body1": {
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "body2": {
      "fontSize": "0.75rem",
      "fontWeight": 400,
      "lineHeight": 1.45
    }
  },
  "shape": {
    "borderRadius": 4
  }
}
